@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt5 5.14 COMPONENTS Core)
include("${CMAKE_CURRENT_LIST_DIR}/BlueprintTargets.cmake")
set(BlueprintFramework_Core_FOUND TRUE)
set(BlueprintFramework_Quick_FOUND FALSE)
if(TARGET Blueprint::Quick)
    find_dependency(Qt5 5.14 COMPONENTS Quick QuickControls2)
    set(BlueprintFramework_Quick_FOUND TRUE)
endif()
check_required_components(BlueprintFramework)
